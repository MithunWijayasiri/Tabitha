{
  "dependencies": {
    "idb": "^8.0.0",
    "lz-string": "^1.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.2.0",
    "@types/webextension-polyfill": "^0.12.5",
    "@unocss/reset": "^66.7.5",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.11.0",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "rimraf": "^6.1.3",
    "svelte": "^5.56.9",
    "svelte-check": "^4.7.6",
    "terser": "^5.50.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "unocss": "^66.7.5",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "web-ext": "^10.6.0",
    "webextension-polyfill": "^0.12.0"
  },
  "name": "tabitha",
  "private": true,
  "scripts": {
    "build": "npm run clean && cross-env NODE_ENV=production run-p build-background build-web",
    "build-background": "vite build -c vite.config.background.ts",
    "build-web": "vite build",
    "build:ff": "npm run clean && cross-env NODE_ENV=production TARGET=firefox run-p build-background build-web",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "clean": "rimraf dist",
    "dev": "npm run clean && cross-env NODE_ENV=development run-p build-background dev-web",
    "dev-web": "vite dev",
    "dev:ff": "npm run clean && cross-env NODE_ENV=development TARGET=firefox run-p build-background dev-web",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "open": "web-ext run -s=dist -t=chromium",
    "open:ff": "web-ext run -s=dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "type": "module",
  "version": "0.1.0"
}
